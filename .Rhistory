write.table(data.frame(t(round(current_dp,dec.precision))),file="dp_out.csv",append=F,quote=F,sep=",",row.names=F,col.names=F)
write.table(data.frame(t(round(current_wr,dec.precision))),file="wr_out.csv",append=F,quote=F,sep=",",row.names=F,col.names=F)
