set.seed(mcmc_seed)
if(!cluster){
save(mcmc_seed,file="./Code/Model Fit/RJMCMC/Results/mcmc_seed.RData")
} else{
save(mcmc_seed,file="./RJMCMC/Results/mcmc_seed.RData")
}
lod <- max(dengue_pone$l_value*1.4,na.rm=T)
## Make day-adjusted day
dengue_pone <- dengue_pone %>%
group_by(No) %>%
mutate(max_value = max(value,na.rm=T)) %>%
mutate(max_day = day[which.max(value)]) %>%
mutate(min_obs_day = min(day)) %>%
mutate(max_obs_day = max(day)) %>%
mutate(min_obs_day_adj = min_obs_day - max_day) %>%
mutate(max_obs_day_adj = max_obs_day - max_day) %>%
mutate(day_adj = day - max_day) %>%
mutate(plasma_leakage_n = plasma_leakage+1) %>%
mutate(peak_left_cens = ifelse(min_obs_day == max_day,1,0)) %>%
mutate(peak_right_cens = ifelse(max_obs_day == max_day,1,0)) %>%
mutate(inf_cens = ifelse(l_value[which.min(day)] < lod,1,0)) %>%
mutate(clear_cens = ifelse(l_value[which.max(day)] < lod,1,0)) %>%
arrange(day_adj) %>%
mutate(is_gt0 = l_value > 0) %>%
mutate(first_gt0 = min(which(is_gt0))) %>%
mutate(first_gt0_adj = first_gt0 - max_day) %>%
mutate(tp_min_adj = -2) %>%
mutate(tp_max_adj = 2) %>%
mutate(last_gt0 = max(which(is_gt0))) %>%
mutate(last_gt0_adj = last_gt0 - max_day) %>%
select(-max_value) %>%
ungroup() %>%
mutate(est_wp_wr = (peak_left_cens == 0 & peak_right_cens == 0)) %>%
mutate(est_wp = (peak_left_cens == 0 & peak_right_cens == 1)) %>%
mutate(est_wr = (peak_left_cens == 1 & peak_right_cens == 0)) %>%
mutate(zero_begin = first_gt0_adj > min_obs_day_adj) %>%
mutate(zero_end = last_gt0_adj < max_obs_day_adj)
## Clear individuals with only 1 measurement
clean_data <- dengue_pone %>%
group_by(No) %>%
mutate(n_gt0 = sum(value > 0,na.rm=T)) %>%
ungroup() %>%
filter(n_gt0 > 1) %>%
# Remove NA values
filter(!is.na(value))
# %>%
#   filter(!(pig_id %in% c(20425,37126)))
save(clean_data,file="~/Documents/Research/Within-Host/Within_Host_CT_Analysis/Data/Dengue/clean_dengue.RData")
n_indiv <- length(unique(clean_data$No))
N_data <- nrow(clean_data)
n_iterations <- 100000
wp_max <- 20
wr_max <- 20
tpsd <- 3
prior_wpmean_mean <- 3
prior_wpmean_sd <- 50
prior_dpmean_mean <- lod/2
prior_dpmean_sd <- lod
prior_wrmean_mean <- 3
prior_wrmean_sd <- 50
prior_wpsd_scale <- 100 # Exponential mean, uniform max
prior_dpsd_scale <- 100
prior_wrsd_scale <- 100
prior_sigma_scale <- 100
prior_wpsd_min <- 0.5
prior_dpsd_min <- 0.5
prior_wrsd_min <- 0.5
prior_wpmean_max <- 20
prior_dpmean_max <- 40
prior_wrmean_max <- 20
prior_wpsd_max <- 100
prior_dpsd_max <- 20
prior_wrsd_max <- 20
prior_sigma_max <- 20
p_model_1_prior <- 0.334
p_model_2_prior <- 0.333
p_model_3_prior <- 0.333
wpmean_sf <- 0.85
wpsd_sf <- 0.85
dpmean_sf <- 1.75
dpsd_sf <- 1
wrmean_sf <- 1
wrsd_sf <- 1
sigma_sf <- 0.5
wp_sf <- 0.3
tp_sf <- 0.2
dp_sf <- 1
wr_sf <- 0.3
lambda <- 0.999
id_adj_table <- 0:(n_indiv-1)
unique_ids <- sort(unique(clean_data$No))
clean_data$index <- id_adj_table[match(clean_data$No,unique_ids)]
infer_dataset <- clean_data %>%
arrange(index,day_adj) %>%
select(No,l_value,day_adj,index)
indiv_dataset <- clean_data %>%
arrange(index) %>%
group_by(No) %>%
filter(l_value == max(l_value)) %>%
mutate(dp_min = l_value - 4) %>%
select(No,index,plasma_leakage,plasma_leakage_n,dp_min,first_gt0_adj,last_gt0_adj,zero_begin,zero_end,est_wp,est_wp_wr,est_wr)
init_model <- ifelse(indiv_dataset$est_wp,1,
ifelse(indiv_dataset$est_wp_wr,2,
ifelse(indiv_dataset$est_wr,3,0)))
init_model[indiv_dataset$zero_begin & indiv_dataset$zero_end] <- 2
init_model[indiv_dataset$zero_begin & init_model == 3] <- 2
init_model[indiv_dataset$zero_end & init_model == 1] <- 2
init_sigma <- 4
init_wp_mean_h1n1 <- 3
init_wp_sd_h1n1 <- 2
init_dp_mean_h1n1 <- lod/2
init_dp_sd_h1n1 <- 10
init_wr_mean_h1n1 <- 5
init_wr_sd_h1n1 <- 1
init_wp_mean_h3n2 <- 3
init_wp_sd_h3n2 <- 2
init_dp_mean_h3n2 <- lod/2
init_dp_sd_h3n2 <- 10
init_wr_mean_h3n2 <- 5
init_wr_sd_h3n2 <- 2
init_wp_mean_dual <- 3
init_wp_sd_dual <- 2
init_dp_mean_dual <- lod/2
init_dp_sd_dual <- 10
init_wr_mean_dual <- 5
init_wr_sd_dual <- 2
init_wp <- rep(NA,n_indiv)
init_tp <- rep(NA,n_indiv)
init_dp <- rep(NA,n_indiv)
init_wr <- rep(NA,n_indiv)
for(i in 1:length(init_model)){
init_dp[i] <- min(indiv_dataset$dp_min[i] + runif(1,0,15),lod)
if(init_model[i] == 1){
## rise then peak
init_tp[i] <- indiv_dataset$last_gt0_adj[i] + rexp(1,1)
init_wp[i] <- init_tp[i] - indiv_dataset$first_gt0_adj[i] + rexp(1,1)
init_wr[i] <- max(rnorm(1,init_wr_mean_h1n1,init_wr_sd_h1n1),0)
# Check:
if(init_tp[i] - init_wp[i] > indiv_dataset$first_gt0_adj[i]){
print("ERR WP SPAN")
}
if(init_wp[i] < 0){
print("ERR WP < 0")
}
} else if(init_model[i] == 2){
## Rise then peak then dip
init_tp[i] <- rtruncnorm(1,a=indiv_dataset$first_gt0_adj[i],b=indiv_dataset$last_gt0_adj[i],0,tpsd)
init_wp[i] <- init_tp[i] - indiv_dataset$first_gt0_adj[i] + rexp(1,1)
init_wr[i] <- indiv_dataset$last_gt0_adj[i] - init_tp[i] + rexp(1,1)
# Check:
if(init_tp[i] - init_wp[i] > indiv_dataset$first_gt0_adj[i]){
print("ERR WP SPAN")
}
if(init_wp[i] < 0){
print("ERR WP < 0")
}
# Check:
if(init_tp[i] + init_wr[i] < indiv_dataset$last_gt0_adj[i]){
print("ERR WR SPAN")
}
if(init_wr[i] < 0){
print("ERR WR < 0")
}
} else{
## Peak then dip
init_tp[i] <- indiv_dataset$first_gt0_adj[i] - rexp(1,1)
init_wp[i] <- max(rnorm(1,init_wr_mean_h1n1,init_wr_sd_h1n1),0)
init_wr[i] <- indiv_dataset$last_gt0_adj[i] - init_tp[i] + rexp(1,1)
# Check:
if(init_tp[i] > indiv_dataset$first_gt0_adj[i]){
print("ERR TP RANGE")
}
if(init_tp[i] + init_wr[i] < indiv_dataset$last_gt0_adj[i]){
print("ERR WR SPAN")
}
if(init_wr[i] < 0){
print("ERR WR < 0")
}
}
}
current_wp <- init_wp
current_tp <- init_tp
current_dp <- init_dp
current_wr <- init_wr
current_sigma <- init_sigma
current_model <- init_model
# check_data(current_model,
#            current_wp,
#            current_tp,
#            current_dp,
#            current_wr,
#            indiv_dataset$first_gt0_adj,
#            indiv_dataset$last_gt0_adj)
current_wpmean_h1n1 <- init_wp_mean_h1n1
current_wpsd_h1n1 <- init_wp_sd_h1n1
current_wpmean_h3n2 <- init_wp_mean_h3n2
current_wpsd_h3n2 <- init_wp_sd_h3n2
current_wpmean_dual <- init_wp_mean_dual
current_wpsd_dual <- init_wp_sd_dual
current_dpmean_h1n1 <- init_dp_mean_h1n1
