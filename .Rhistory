current_wrmean_h3n2 <- init_wr_mean_h3n2
current_wrsd_h3n2 <- init_wr_sd_h3n2
current_wrmean_dual <- init_wr_mean_dual
current_wrsd_dual <- init_wr_sd_dual
## Initialize MCMC
log_lh_current = log_likelihood(infer_dataset$l_value,
infer_dataset$day_adj,
infer_dataset$index,
current_wp,
current_tp,
current_dp,
current_wr,
current_sigma,
lambda,
indiv_dataset$plasma_leakage_n,
current_model,
current_wpmean_h1n1,
current_wpsd_h1n1,
current_wpmean_h3n2,
current_wpsd_h3n2,
current_wpmean_dual,
current_wpsd_dual,
current_dpmean_h1n1,
current_dpsd_h1n1,
current_dpmean_h3n2,
current_dpsd_h3n2,
current_dpmean_dual,
current_dpsd_dual,
current_wrmean_h1n1,
current_wrsd_h1n1,
current_wrmean_h3n2,
current_wrsd_h3n2,
current_wrmean_dual,
current_wrsd_dual,
tpsd)
print(paste0("Initial log likelihood: ",log_lh_current))
scalar_params_out <- data.frame(wp_mean_h1n1=current_wpmean_h1n1,
wp_mean_h3n2=current_wpmean_h3n2,
wp_mean_dual=current_wpmean_dual,
wp_sd_h1n1=current_wpsd_h1n1,
wp_sd_h3n2=current_wpsd_h3n2,
wp_sd_dual=current_wpsd_dual,
dp_mean_h1n1=current_dpmean_h1n1,
dp_mean_h3n2=current_dpmean_h3n2,
dp_mean_dual=current_dpmean_dual,
dp_sd_h1n1=current_dpsd_h1n1,
dp_sd_h3n2=current_dpsd_h3n2,
dp_sd_dual=current_dpsd_dual,
wr_mean_h1n1=current_wrmean_h1n1,
wr_mean_h3n2=current_wrmean_h3n2,
wr_mean_dual=current_wrmean_dual,
wr_sd_h1n1=current_wrsd_h1n1,
wr_sd_h3n2=current_wrsd_h3n2,
wr_sd_dual=current_wrsd_dual,
sigma=current_sigma,
log_lh=log_lh_current)
